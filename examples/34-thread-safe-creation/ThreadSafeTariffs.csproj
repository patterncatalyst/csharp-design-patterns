<!-- Chapter 34 example: three ways to build a shipping tariff table exactly
     once under concurrent first use, a lazily-published singleton over
     Lazy<T>, a lock-guarded builder over the modern System.Threading.Lock
     type, and an eagerly-built static singleton. TargetFramework,
     LangVersion, Nullable, etc. are inherited from examples/Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The test project lives in a subdirectory of this one; exclude its
         sources so this library's own compile item group does not also pick
         them up. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ThreadSafeTariffs.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kept consistent with the other examples' test-visibility seam, even
         though every member the tests exercise here is already public. -->
    <InternalsVisibleTo Include="ThreadSafeTariffs.Tests" />
  </ItemGroup>

</Project>
