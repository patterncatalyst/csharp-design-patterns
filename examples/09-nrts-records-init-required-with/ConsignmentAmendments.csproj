<!-- Chapter 9 example: nullable reference types, records, and init/required/with.
     TargetFramework, LangVersion, Nullable, etc. are inherited from
     examples/Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The test project lives in a subdirectory of this one; exclude its
         sources so this library's own compile item group does not also pick
         them up. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ConsignmentAmendments.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
