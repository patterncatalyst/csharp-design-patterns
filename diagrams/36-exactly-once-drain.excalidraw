   "seed": 1476290228,
   "versionNonce": 1346794569,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Submitting a known number of events, completing the writer, and waiting for every consumer task to finish proves each event is recorded exactly once; a single producer's order survives a single consumer because the channel is first in, first out.",
   "fontSize": 12.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Submitting a known number of events, completing the writer, and waiting for every consumer task to finish proves each event is recorded exactly once; a single producer's order survives a single consumer because the channel is first in, first out.",
   "lineHeight": 1.25,
   "baseline": 12.5
  }
