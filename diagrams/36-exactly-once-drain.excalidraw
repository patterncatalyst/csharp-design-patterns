  {
   "id": "t16941592",
   "type": "text",
   "x": 480,
   "y": 520,
   "width": 1691.2500000000002,
   "height": 15.625,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
