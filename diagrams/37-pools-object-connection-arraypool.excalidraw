  },
  {
   "id": "t1552105853",
   "type": "text",
   "x": 480,
   "y": 520,
   "width": 1409.3750000000002,
   "height": 15.625,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 427325092,
   "versionNonce": 1346079436,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "GatewayConnectionPool hands connections to renters and takes them back on return, parking a renter when the pool runs out. ManifestWriter rents and returns a scratch buffer from an array pool the same way.",
   "fontSize": 12.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "GatewayConnectionPool hands connections to renters and takes them back on return, parking a renter when the pool runs out. ManifestWriter rents and returns a scratch buffer from an array pool the same way.",
   "lineHeight": 1.25,
   "baseline": 12.5
  }
 ],
