   "seed": 1943633245,
   "versionNonce": 856689046,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Renting a buffer, using it, and returning it cleared means the next rent gets back the same array. Allocating a fresh array on every call instead produces garbage with nothing to reuse.",
   "fontSize": 12.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Renting a buffer, using it, and returning it cleared means the next rent gets back the same array. Allocating a fresh array on every call instead produces garbage with nothing to reuse.",
   "lineHeight": 1.25,
   "baseline": 12.5
  }
